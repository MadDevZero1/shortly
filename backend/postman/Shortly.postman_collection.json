{
  "info":{"name":"Shortly API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:5000"},{"key":"shortCode","value":"12345678"},{"key":"token","value":""}],
  "item":[
    {"name":"Health","event":[{"listen":"test","script":{"exec":["pm.test('Healthy', () => pm.response.to.have.status(200));"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/health"}},
    {"name":"Create link","event":[{"listen":"test","script":{"exec":["pm.test('Created', () => pm.response.to.have.status(201));","if (pm.response.code === 201) pm.collectionVariables.set('shortCode',pm.response.json().data.shortCode);"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/shorten","body":{"mode":"raw","raw":"{\"longUrl\":\"https://example.com/article\"}"}}},
    {"name":"Invalid URL","event":[{"listen":"test","script":{"exec":["pm.test('Invalid URL rejected', () => pm.response.to.have.status(400));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/shorten","body":{"mode":"raw","raw":"{\"longUrl\":\"javascript:alert(1)\"}"}}},
    {"name":"Redirect (disable follow redirects)","protocolProfileBehavior":{"followRedirects":false},"event":[{"listen":"test","script":{"exec":["pm.test('Temporary redirect', () => pm.response.to.have.status(302));","pm.test('Stored destination', () => pm.expect(pm.response.headers.get('Location')).to.eql('https://example.com/article'));"]}}],"request":{"method":"GET","url":"{{baseUrl}}/{{shortCode}}"}},
    {"name":"Missing link","event":[{"listen":"test","script":{"exec":["pm.test('Missing link', () => pm.response.to.have.status(404));"]}}],"request":{"method":"GET","url":"{{baseUrl}}/00000000"}},
    {"name":"Private analytics","event":[{"listen":"test","script":{"exec":["pm.test('Owner analytics', () => pm.response.to.have.status(200));","pm.test('Thirty UTC days', () => pm.expect(pm.response.json().data.clicksPerDay).to.have.lengthOf(30));"]}}],"request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/stats/{{shortCode}}"}},
    {"name":"Own links","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/urls"}},
    {"name":"Own summary","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/summary"}},
    {"name":"Unauthenticated analytics","event":[{"listen":"test","script":{"exec":["pm.test('Requires authentication', () => pm.response.to.have.status(401));"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/stats/{{shortCode}}"}},
    {"name":"Rate-limit verification (run separately)","item":[{"name":"Creation returns 429 after twenty requests per user/minute","event":[{"listen":"test","script":{"exec":["pm.test('Created or rate limited', () => pm.expect([201,429]).to.include(pm.response.code));","if(pm.response.code === 429) pm.test('Retry-After provided', () => pm.expect(pm.response.headers.get('Retry-After')).to.exist);"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/shorten","body":{"mode":"raw","raw":"{\"longUrl\":\"https://example.com/rate-test\"}"}}}]}
  ]
}
